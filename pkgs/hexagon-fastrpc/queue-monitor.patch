   pthread_mutex_unlock(&q->mutex);
   locked = 0;
+
+  /* Glymur queue-monitor firmware consumes synchronous requests only when
+   * the host invokes method 9. Keep the generic runtime opt-in. */
+  const char *queue_monitor = getenv("DSPQUEUE_QUEUE_MONITOR");
+  if (queue_monitor && strcmp(queue_monitor, "1") == 0) {
+    int32_t num_read = 0;
+    nErr = dspqueue_rpc_queue_monitor(dq->dsp_handle, q->dsp_id, &num_read);
+    if (nErr != AEE_SUCCESS) {
+      FARF(ERROR, "%s: queue_monitor failed: 0x%x", __func__, nErr);
+      /* The packet is already published: do not enter bail, which would
+       * undo references still owned by the queued packet. */
+      return nErr;
