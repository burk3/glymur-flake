{
  lib,
  runCommand,
  writeText,
  alsa-ucm-conf,
  longName,
  levels,
  compressor,
}:

let
  amps = [
    "WooferLeft"
    "TweeterLeft"
    "WooferRight"
    "TweeterRight"
  ];
  cset = name: value: ''cset "name='${name}' ${toString value}"'';
  seq = lines: lib.concatMapStringsSep "\n" (l: "\t\t${l}") lines;
  dB =
    tenths:
    let
      a = if tenths < 0 then -tenths else tenths;
    in
    "${lib.optionalString (tenths < 0) "-"}${toString (a / 10)}.${toString (lib.mod a 10)} dB";

  macros = [
    "WSA"
    "WSA2"
  ];
  comp = if compressor then 1 else 0;
  macroEnable = m: [
    (cset "${m} WSA RX0 MUX" "AIF1_PB")
    (cset "${m} WSA RX1 MUX" "AIF1_PB")
    (cset "${m} WSA_RX0 INP0" "RX0")
    (cset "${m} WSA_RX1 INP0" "RX1")
    (cset "${m} WSA_COMP1 Switch" comp)
    (cset "${m} WSA_COMP2 Switch" comp)
    (cset "${m} WSA_RX0 Digital Volume" levels.wooferDigital)
    (cset "${m} WSA_RX1 Digital Volume" levels.tweeterDigital)
  ];
  macroDisable = m: [
    (cset "${m} WSA_RX0 INP0" "ZERO")
    (cset "${m} WSA_RX1 INP0" "ZERO")
    (cset "${m} WSA RX0 MUX" "ZERO")
    (cset "${m} WSA RX1 MUX" "ZERO")
  ];
  ampEnable = a: [
    (cset "${a} COMP Switch" comp)
    (cset "${a} BOOST Switch" 1)
    (cset "${a} DAC Switch" 1)
    (cset "${a} PBR Switch" 1)
    (cset "${a} VISENSE Switch" 0)
    (cset "${a} WSA MODE" 0)
    (cset "${a} PA Volume" levels.ampVolume)
  ];
  ampDisable = a: [
    (cset "${a} COMP Switch" 0)
    (cset "${a} BOOST Switch" 0)
    (cset "${a} DAC Switch" 0)
    (cset "${a} PBR Switch" 0)
    (cset "${a} VISENSE Switch" 0)
  ];

  speakerRoute = "WSA_CODEC_DMA_RX_0 Audio Mixer MultiMedia1";
  micRoute = "MultiMedia2 Mixer VA_CODEC_DMA_TX_0";

  card = writeText "Zenbook-A16-UX3607OA.conf" ''
    Syntax 4

    # ASUS Zenbook A16 (UX3607OA), generated by modules/zenbook/audio (NixOS).
    SectionUseCase."HiFi" {
    	File "/Qualcomm/glymur/Zenbook-A16-UX3607OA-HiFi.conf"
    	Comment "HiFi quality Music"
    }
  '';

  hifi = writeText "Zenbook-A16-UX3607OA-HiFi.conf" ''
    # ASUS Zenbook A16 (UX3607OA) HiFi verb, generated by modules/zenbook/audio
    # from alsa-ucm-conf d260eedd (ZenbookA16-HiFi.conf), with fixed levels:
    #   WSA/WSA2 RX0 (woofers)  digital ${toString levels.wooferDigital} (${
      dB ((levels.wooferDigital - 84) * 10)
    }; kernel max 81 = -3 dB)
    #   WSA/WSA2 RX1 (tweeters) digital ${toString levels.tweeterDigital} (${
      dB ((levels.tweeterDigital - 84) * 10)
    })
    #   WSA884x PA Volume ${toString levels.ampVolume} of 6 (${dB (levels.ampVolume * 15 - 90)})
    #   Compressors (WSA/WSA2 WSA_COMP1/2, amp COMP): ${if compressor then "on" else "off"}
    # No PlaybackMixerElem: PipeWire uses software volume, the levels stay put.

    SectionVerb {
    	EnableSequence [
    ${seq [
      (cset speakerRoute 1)
      (cset micRoute 1)
    ]}
    	]
    	DisableSequence [
    ${seq [
      (cset speakerRoute 0)
      (cset micRoute 0)
    ]}
    	]
    	Value {
    		TQ "HiFi"
    	}
    }

    SectionDevice."Speaker" {
    	Comment "Speaker playback"

    	EnableSequence [
    ${seq (
      [ (cset speakerRoute 1) ] ++ lib.concatMap macroEnable macros ++ lib.concatMap ampEnable amps
    )}
    	]

    	DisableSequence [
    ${seq (lib.concatMap ampDisable amps ++ lib.concatMap macroDisable macros)}
    	]

    	Value {
    		PlaybackChannels 4
    		PlaybackPriority 100
    		PlaybackPCM "hw:''${CardId},0"
    	}
    }

    # As upstream; not tested here.
    SectionDevice."Mic" {
    	Comment "Internal microphones"

    	EnableSequence [
    ${seq [
      (cset micRoute 1)
      (cset "VA DEC0 MUX" "VA_DMIC")
      (cset "VA DMIC MUX0" "DMIC0")
      (cset "VA_AIF1_CAP Mixer DEC0" 1)
      (cset "VA_DEC0 Volume" 100)
      (cset "VA DEC1 MUX" "VA_DMIC")
      (cset "VA DMIC MUX1" "DMIC1")
      (cset "VA_AIF1_CAP Mixer DEC1" 1)
      (cset "VA_DEC1 Volume" 100)
    ]}
    	]

    	DisableSequence [
    ${seq [
      (cset "VA DMIC MUX0" "ZERO")
      (cset "VA_DEC0 Volume" 0)
      (cset "VA_AIF1_CAP Mixer DEC0" 0)
      (cset "VA DMIC MUX1" "ZERO")
      (cset "VA_DEC1 Volume" 0)
      (cset "VA_AIF1_CAP Mixer DEC1" 0)
    ]}
    	]

    	Value {
    		CapturePriority 100
    		CapturePCM "hw:''${CardId},1"
    	}
    }
  '';
in
runCommand "alsa-ucm-conf-zenbook-a16-${alsa-ucm-conf.version}"
  {
    passthru = { inherit card hifi; };
  }
  ''
    mkdir -p $out/share/alsa
    cp -r --no-preserve=mode ${alsa-ucm-conf}/share/alsa/ucm2 $out/share/alsa/ucm2
    u=$out/share/alsa/ucm2
    install -m 0444 ${card} $u/Qualcomm/glymur/Zenbook-A16-UX3607OA.conf
    install -m 0444 ${hifi} $u/Qualcomm/glymur/Zenbook-A16-UX3607OA-HiFi.conf
    mkdir -p $u/conf.d/glymur
    ln -s ../../Qualcomm/glymur/Zenbook-A16-UX3607OA.conf $u/conf.d/glymur/${lib.escapeShellArg "${longName}.conf"}
  ''
