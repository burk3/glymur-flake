From 856224c5d178fa828215b3eb8921e97b4a8ac122 Mon Sep 17 00:00:00 2001
From: Burke Cates <burke.cates@gmail.com>
Date: Fri, 23 Oct 2026 10:00:00 +0000
Subject: [PATCH] NOT-FOR-UPSTREAM: LAB-ONLY: drm/msm/dp: link training fault injection

LAB-ONLY, never to be sent upstream. Applies on top of "drm/msm/dp:
retry eDP link training before falling back", which must build and
work without it.

The msm module parameter dp_lt_inject_eq_fail (int, default 0, 0644)
makes the next N link training attempts fail. Every attempt uses up
one count: one that passed is turned into a channel equalization
timeout, one that failed on its own still counts, so exactly N failed
attempts follow and the retry budget is exercised the same way whatever
the hardware does. The per-attempt warning gets a suffix saying which
("(fault injection: injected)" or "(fault injection: failed on its own,
counted by injection)"); the rest of the warning and the give-up error
are unchanged, so lab-edp-retrain's matches still work.

Set it on the kernel command line (msm.dp_lt_inject_eq_fail=N) to hit
the boot modeset, or at runtime through /sys/module/msm/parameters/
before a DPMS cycle. With the eDP retries, N=1..3 still ends at the
panel's maximum parameters; N=4 exhausts them and exercises the give-up
path.

Upstream DRM would want a debugfs knob rather than a module parameter;
the cover letter offers one if the maintainers ask.
Assisted-by: LLM
---
Not-for-upstream: local workaround for one laptop, not reviewed for
  submission; use only for local testing.

Regenerated on v7.4-rc2 (context only, 4dd10fbbe devm conversion; was
fuzz 2 with patch -p1).

 drivers/gpu/drm/msm/dp/dp_ctrl.c | 40 ++++++++++++++++++++++++++++++--
 1 file changed, 38 insertions(+), 2 deletions(-)

diff --git a/drivers/gpu/drm/msm/dp/dp_ctrl.c b/drivers/gpu/drm/msm/dp/dp_ctrl.c
index 6a5e0dfff86f..07b3690590b4 100644
--- a/drivers/gpu/drm/msm/dp/dp_ctrl.c
+++ b/drivers/gpu/drm/msm/dp/dp_ctrl.c
@@ -10,6 +10,7 @@
 #include <linux/completion.h>
 #include <linux/delay.h>
 #include <linux/iopoll.h>
+#include <linux/moduleparam.h>
 #include <linux/phy/phy.h>
 #include <linux/phy/phy-dp.h>
 #include <linux/pm_opp.h>
@@ -84,10 +85,23 @@ enum {
 /* eDP has one mode: retry before falling back to a link that can't carry it */
 #define MSM_DP_EDP_LT_SAME_PARAM_RETRIES	3
 
+/*
+ * LAB-ONLY fault injection for the retry paths: make the next N link training
+ * attempts fail. Every attempt uses up one count, whether it failed on its own
+ * or passed and is then failed here as a channel equalization timeout, so
+ * exactly N failed attempts follow, real or injected. The count is shared by
+ * all DP controllers.
+ */
+static int dp_lt_inject_eq_fail;
+module_param(dp_lt_inject_eq_fail, int, 0644);
+MODULE_PARM_DESC(dp_lt_inject_eq_fail,
+		 "Debug: make the next N link training attempts fail (default 0)");
+
 struct msm_dp_lt_attempt {
 	int num;
 	int training_step;
 	int rc;
+	const char *inject_note;
 	struct msm_dp_link_info link_params;
 	struct msm_dp_link_phy_params phy_params;
 	int status_rc;
@@ -157,6 +171,9 @@ struct msm_dp_ctrl_private {
 	bool link_clks_on;
 	bool stream_clks_on[DP_STREAM_MAX];
 	bool phy_powered_on;
+
+	/* What dp_lt_inject_eq_fail did to the last training attempt, or NULL */
+	const char *lt_inject_note;
 };
 
 static inline u32 msm_dp_read_ahb(const struct msm_dp_ctrl_private *ctrl, u32 offset)
@@ -1819,6 +1836,19 @@ static int msm_dp_ctrl_setup_main_link(struct msm_dp_ctrl_private *ctrl,
 
 	ret = msm_dp_ctrl_link_train(ctrl, panel, training_step);
 
+	ctrl->lt_inject_note = NULL;
+	if (READ_ONCE(dp_lt_inject_eq_fail) > 0) {
+		WRITE_ONCE(dp_lt_inject_eq_fail,
+			   READ_ONCE(dp_lt_inject_eq_fail) - 1);
+		if (ret) {
+			ctrl->lt_inject_note = "failed on its own, counted by injection";
+		} else {
+			ctrl->lt_inject_note = "injected";
+			*training_step = DP_TRAINING_2;
+			ret = -ETIMEDOUT;
+		}
+	}
+
 	return ret;
 }
 
@@ -1853,6 +1883,7 @@ static void msm_dp_ctrl_record_lt_failure(struct msm_dp_ctrl_private *ctrl,
 	attempt->num++;
 	attempt->training_step = training_step;
 	attempt->rc = rc;
+	attempt->inject_note = ctrl->lt_inject_note;
 	attempt->link_params = ctrl->link->link_params;
 	attempt->phy_params = ctrl->link->phy_params;
 	attempt->status_rc = drm_dp_dpcd_read_link_status(ctrl->aux,
@@ -1875,6 +1906,7 @@ static void msm_dp_ctrl_log_lt_attempt(struct msm_dp_ctrl_private *ctrl,
 	const char *step = "?";
 	char status[32];
 	char next_str[32] = "";
+	char inject[64] = "";
 
 	if (attempt->training_step >= 0 &&
 	    attempt->training_step < ARRAY_SIZE(phase))
@@ -1891,12 +1923,16 @@ static void msm_dp_ctrl_log_lt_attempt(struct msm_dp_ctrl_private *ctrl,
 		snprintf(next_str, sizeof(next_str), ", next at %u x%u",
 			 next->rate, next->num_lanes);
 
+	if (attempt->inject_note)
+		snprintf(inject, sizeof(inject), " (fault injection: %s)",
+			 attempt->inject_note);
+
 	dev_warn(ctrl->dev,
-		 "%s: link training attempt %d failed in %s phase (%pe) at %u x%u, vs %u pe %u, DPCD 0x202: %s%s\n",
+		 "%s: link training attempt %d failed in %s phase (%pe) at %u x%u, vs %u pe %u, DPCD 0x202: %s%s%s\n",
 		 msm_dp_ctrl_conn_name(panel), attempt->num, step,
 		 ERR_PTR(attempt->rc), attempt->link_params.rate,
 		 attempt->link_params.num_lanes, attempt->phy_params.v_level,
-		 attempt->phy_params.p_level, status, next_str);
+		 attempt->phy_params.p_level, status, inject, next_str);
 }
 
 static void msm_dp_ctrl_log_lt_give_up(struct msm_dp_ctrl_private *ctrl,
-- 
