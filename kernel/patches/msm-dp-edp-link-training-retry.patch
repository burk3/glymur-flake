From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Burke Cates <burke.cates@gmail.com>
Date: Fri, 23 Oct 2026 09:00:00 +0000
Subject: [PATCH] NOT-FOR-UPSTREAM: drm/msm/dp: retry eDP link training before falling back

On the ASUS Zenbook A16 (Glymur, Samsung ATNA60HR07 eDP panel, 4 x HBR2)
about one boot in nine fails channel equalization on the first attempt.
msm_dp_ctrl_on_link() then sees clock recovery OK on all lanes and
halves the lane count. The x2 link trains, but 2 x HBR2 (8.64 Gbps)
cannot carry the panel's only mode (709.633 MHz: 12.8 Gbps at 18 bpp,
17.03 Gbps at 24 bpp; only 4 x HBR2 = 17.28 Gbps fits), and the TU
setup for it is impossible (valid_boundary_link 127 > tu_size 64), so
the "successful" enable leaves a dark panel. A PHY power cycle and a
second attempt at x4 is known to work.

For eDP:

- Retry training at the same rate and lane count up to 3 times, each
  after the existing PHY power cycle (msm_dp_ctrl_reinitialize_mainlink())
  with the drive levels reset, before any rate/lane fallback. An eDP
  panel has a single fixed mode, so a fallback is only worth trying
  once the full link has had a fair chance. These attempts do not use
  up fallback steps.
- Refuse a fallback whose bandwidth (rate * lanes * 8) cannot carry the
  mode at the bpp in effect, as i915 does in
  intel_dp_can_link_train_fallback_for_edp(), and fail the enable
  instead of reporting success on an unusable link.
- msm_dp_ctrl_prepare_stream_on() ignored the result of its forced
  retrain. Retry it the same way and return the error, since on eDP
  the stream would show nothing. External DP keeps the old best-effort
  behaviour.

For all sinks:

- Log one warning per failed attempt: connector, attempt number, failing
  phase (setup, CR or EQ), error, rate, lanes, the last voltage swing
  and pre-emphasis levels, DPCD 0x202-0x207 (so per-lane failures can be
  told apart from AUX errors) and the parameters of the next attempt.
  The DPCD status is read before a fallback changes link_params. Log one
  error when training gives up: attempts, last parameters, mode, bpp and
  the reason. The per-phase errors that restated the same failure ("link
  training #2 on phy 0 failed", "link training on sink failed", "max
  tries reached", "Failed link training", "DP display prepare failed")
  become debug messages, so one failed attempt is one line and a give-up
  is one more.
- Print these with the controller's struct device. ctrl->drm_dev is
  never assigned, so drm_warn(ctrl->drm_dev, ...) printed
  "(NULL device *)".
- Give up as soon as the last allowed attempt fails. The old loop chose
  a fallback, power cycled the PHY for it, and then ran out of
  attempts without trying it.
- On failure, restore link_params and phy_params to the last attempt
  that ran, so a fallback that was chosen but never tried is not left
  behind. Debugfs dp_debug reads them, and showed "num_lanes = 2" after
  an eDP give-up whose attempts were all at x4. They still do not say
  whether that attempt trained; the error and the failed enable do.

Assisted-by: LLM
---
Not-for-upstream: local workaround for one laptop, not reviewed for
  submission; use only for local testing.

diff --git a/drivers/gpu/drm/msm/dp/dp_ctrl.c b/drivers/gpu/drm/msm/dp/dp_ctrl.c
--- a/drivers/gpu/drm/msm/dp/dp_ctrl.c
+++ b/drivers/gpu/drm/msm/dp/dp_ctrl.c
@@ -17,6 +17,7 @@
 #include <linux/string_choices.h>
 
 #include <drm/display/drm_dp_helper.h>
+#include <drm/drm_connector.h>
 #include <drm/drm_device.h>
 #include <drm/drm_fixed.h>
 #include <drm/drm_print.h>
@@ -80,6 +81,19 @@ enum {
 	DP_TRAINING_2,
 };
 
+/* eDP has one mode: retry before falling back to a link that can't carry it */
+#define MSM_DP_EDP_LT_SAME_PARAM_RETRIES	3
+
+struct msm_dp_lt_attempt {
+	int num;
+	int training_step;
+	int rc;
+	struct msm_dp_link_info link_params;
+	struct msm_dp_link_phy_params phy_params;
+	int status_rc;
+	u8 status[DP_LINK_STATUS_SIZE];
+};
+
 struct msm_dp_tu_calc_input {
 	u64 lclk;        /* 162, 270, 540 and 810 */
 	u64 pclk_khz;    /* in KHz */
@@ -1503,7 +1517,7 @@ static int msm_dp_ctrl_link_train_1(stru
 
 		if (ctrl->link->phy_params.v_level >=
 			DP_TRAIN_LEVEL_MAX) {
-			DRM_ERROR_RATELIMITED("max v_level reached\n");
+			drm_dbg_dp(ctrl->drm_dev, "max v_level reached\n");
 			return -EAGAIN;
 		}
 
@@ -1518,7 +1532,7 @@ static int msm_dp_ctrl_link_train_1(stru
 			return ret;
 	}
 
-	DRM_ERROR("max tries reached\n");
+	drm_dbg_dp(ctrl->drm_dev, "max tries reached\n");
 	return -ETIMEDOUT;
 }
 
@@ -1652,14 +1666,16 @@ static int msm_dp_ctrl_link_train_1_2(st
 
 	ret = msm_dp_ctrl_link_train_1(ctrl, panel, training_step, dp_phy);
 	if (ret) {
-		DRM_ERROR("link training #1 on phy %d failed. ret=%d\n", dp_phy, ret);
+		drm_dbg_dp(ctrl->drm_dev, "link training #1 on phy %d failed. ret=%d\n",
+			   dp_phy, ret);
 		return ret;
 	}
 	drm_dbg_dp(ctrl->drm_dev, "link training #1 on phy %d successful\n", dp_phy);
 
 	ret = msm_dp_ctrl_link_train_2(ctrl, panel, training_step, dp_phy);
 	if (ret) {
-		DRM_ERROR("link training #2 on phy %d failed. ret=%d\n", dp_phy, ret);
+		drm_dbg_dp(ctrl->drm_dev, "link training #2 on phy %d failed. ret=%d\n",
+			   dp_phy, ret);
 		return ret;
 	}
 	drm_dbg_dp(ctrl->drm_dev, "link training #2 on phy %d successful\n", dp_phy);
@@ -1719,13 +1735,15 @@ static int msm_dp_ctrl_link_train(struct
 	}
 
 	if (ret) {
-		DRM_ERROR("link training of LTTPR(s) failed. ret=%d\n", ret);
+		drm_dbg_dp(ctrl->drm_dev, "link training of LTTPR(s) failed. ret=%d\n",
+			   ret);
 		goto end;
 	}
 
 	ret = msm_dp_ctrl_link_train_1_2(ctrl, panel, training_step, DP_PHY_DPRX);
 	if (ret) {
-		DRM_ERROR("link training on sink failed. ret=%d\n", ret);
+		drm_dbg_dp(ctrl->drm_dev, "link training on sink failed. ret=%d\n",
+			   ret);
 		goto end;
 	}
 
@@ -1757,6 +1775,98 @@ static int msm_dp_ctrl_setup_main_link(s
 	return ret;
 }
 
+static bool msm_dp_ctrl_is_edp(const struct msm_dp_panel *panel)
+{
+	return panel->connector &&
+	       panel->connector->connector_type == DRM_MODE_CONNECTOR_eDP;
+}
+
+static const char *msm_dp_ctrl_conn_name(const struct msm_dp_panel *panel)
+{
+	return panel->connector ? panel->connector->name : "DP";
+}
+
+/* Same check as msm_dp_display_mode_valid() */
+static bool msm_dp_ctrl_link_fits_mode(struct msm_dp_ctrl_private *ctrl,
+				       const struct msm_dp_panel *panel,
+				       unsigned long pixel_rate)
+{
+	const struct msm_dp_link_info *lp = &ctrl->link->link_params;
+	u64 need = (u64)pixel_rate * panel->msm_dp_mode.bpp;
+	u64 have = (u64)lp->rate * lp->num_lanes * 8;
+
+	return need <= have;
+}
+
+/* Call before a fallback changes link_params */
+static void msm_dp_ctrl_record_lt_failure(struct msm_dp_ctrl_private *ctrl,
+					  struct msm_dp_lt_attempt *attempt,
+					  int training_step, int rc)
+{
+	attempt->num++;
+	attempt->training_step = training_step;
+	attempt->rc = rc;
+	attempt->link_params = ctrl->link->link_params;
+	attempt->phy_params = ctrl->link->phy_params;
+	attempt->status_rc = drm_dp_dpcd_read_link_status(ctrl->aux,
+							  attempt->status);
+	if (attempt->status_rc < 0)
+		memset(attempt->status, 0, sizeof(attempt->status));
+}
+
+/* @next: the link the next attempt will use, NULL if there is none */
+static void msm_dp_ctrl_log_lt_attempt(struct msm_dp_ctrl_private *ctrl,
+				       const struct msm_dp_panel *panel,
+				       const struct msm_dp_lt_attempt *attempt,
+				       const struct msm_dp_link_info *next)
+{
+	static const char * const phase[] = {
+		[DP_TRAINING_NONE] = "setup",
+		[DP_TRAINING_1] = "CR",
+		[DP_TRAINING_2] = "EQ",
+	};
+	const char *step = "?";
+	char status[32];
+	char next_str[32] = "";
+
+	if (attempt->training_step >= 0 &&
+	    attempt->training_step < ARRAY_SIZE(phase))
+		step = phase[attempt->training_step];
+
+	if (attempt->status_rc < 0)
+		snprintf(status, sizeof(status), "unreadable (%pe)",
+			 ERR_PTR(attempt->status_rc));
+	else
+		snprintf(status, sizeof(status), "%*ph",
+			 DP_LINK_STATUS_SIZE, attempt->status);
+
+	if (next)
+		snprintf(next_str, sizeof(next_str), ", next at %u x%u",
+			 next->rate, next->num_lanes);
+
+	dev_warn(ctrl->dev,
+		 "%s: link training attempt %d failed in %s phase (%pe) at %u x%u, vs %u pe %u, DPCD 0x202: %s%s\n",
+		 msm_dp_ctrl_conn_name(panel), attempt->num, step,
+		 ERR_PTR(attempt->rc), attempt->link_params.rate,
+		 attempt->link_params.num_lanes, attempt->phy_params.v_level,
+		 attempt->phy_params.p_level, status, next_str);
+}
+
+static void msm_dp_ctrl_log_lt_give_up(struct msm_dp_ctrl_private *ctrl,
+				       const struct msm_dp_panel *panel,
+				       const char *what,
+				       const struct msm_dp_lt_attempt *attempt,
+				       const char *reason)
+{
+	dev_err(ctrl->dev,
+		"%s: %s failed after %d attempt%s, last at %u x%u (mode %d kHz, %u bpp): %s\n",
+		msm_dp_ctrl_conn_name(panel), what, attempt->num,
+		attempt->num == 1 ? "" : "s", attempt->link_params.rate,
+		attempt->link_params.num_lanes,
+		panel->msm_dp_mode.drm_mode.clock, panel->msm_dp_mode.bpp,
+		reason);
+}
+
 int msm_dp_ctrl_core_clk_enable(struct msm_dp_ctrl *msm_dp_ctrl)
 {
 	struct msm_dp_ctrl_private *ctrl;
@@ -2103,8 +2213,13 @@ static int msm_dp_ctrl_link_maintenance(
 	ctrl->link->phy_params.v_level = 0;
 
 	ret = msm_dp_ctrl_setup_main_link(ctrl, panel, &training_step);
-	if (ret)
+	if (ret) {
+		struct msm_dp_lt_attempt attempt = {};
+
+		msm_dp_ctrl_record_lt_failure(ctrl, &attempt, training_step, ret);
+		msm_dp_ctrl_log_lt_attempt(ctrl, panel, &attempt, NULL);
 		goto end;
+	}
 
 	msm_dp_ctrl_clear_training_pattern(ctrl, panel, DP_PHY_DPRX);
 
@@ -2396,14 +2511,19 @@ int msm_dp_ctrl_on_link(struct msm_dp_ct
 	u32 rate;
 	int link_train_max_retries = 5;
 	u32 const phy_cts_pixel_clk_khz = 148500;
-	u8 link_status[DP_LINK_STATUS_SIZE];
-	unsigned int training_step;
+	int training_step;
 	unsigned long pixel_rate;
+	struct msm_dp_lt_attempt attempt = {};
+	const u8 *link_status = attempt.status;
+	int same_param_retries = 0;
+	const char *reason = NULL;
+	bool is_edp;
 
 	if (!msm_dp_ctrl)
 		return -EINVAL;
 
 	ctrl = container_of(msm_dp_ctrl, struct msm_dp_ctrl_private, msm_dp_ctrl);
+	is_edp = msm_dp_ctrl_is_edp(panel);
 
 	rate = panel->link_info.rate;
 	pixel_rate = panel->msm_dp_mode.drm_mode.clock;
@@ -2442,8 +2562,11 @@ int msm_dp_ctrl_on_link(struct msm_dp_ct
 		pixel_rate);
 
 	rc = msm_dp_ctrl_enable_mainlink_clocks(ctrl, panel);
-	if (rc)
+	if (rc) {
+		dev_err(ctrl->dev, "%s: failed to enable mainlink clocks: %pe\n",
+			msm_dp_ctrl_conn_name(panel), ERR_PTR(rc));
 		return rc;
+	}
 
 	while (--link_train_max_retries) {
 		training_step = DP_TRAINING_NONE;
@@ -2451,12 +2574,26 @@ int msm_dp_ctrl_on_link(struct msm_dp_ct
 		if (rc == 0) {
 			/* training completed successfully */
 			break;
+		}
+
+		msm_dp_ctrl_record_lt_failure(ctrl, &attempt, training_step, rc);
+
+		if (is_edp &&
+		    same_param_retries < MSM_DP_EDP_LT_SAME_PARAM_RETRIES) {
+			/* Does not use up a fallback step */
+			same_param_retries++;
+			link_train_max_retries++;
+			msm_dp_ctrl_clear_training_pattern(ctrl, panel, DP_PHY_DPRX);
+			msm_dp_link_reset_phy_params_vx_px(ctrl->link);
+		} else if (link_train_max_retries == 1) {
+			reason = "attempt limit reached";
+			break;
 		} else if (training_step == DP_TRAINING_1) {
 			/* link train_1 failed */
-			if (!msm_dp_aux_is_link_connected(ctrl->aux))
+			if (!msm_dp_aux_is_link_connected(ctrl->aux)) {
+				reason = "sink disconnected";
 				break;
-
-			drm_dp_dpcd_read_link_status(ctrl->aux, link_status);
+			}
 
 			rc = msm_dp_ctrl_link_rate_down_shift(ctrl);
 			if (rc < 0) { /* already in RBR = 1.6G */
@@ -2469,19 +2606,21 @@ int msm_dp_ctrl_on_link(struct msm_dp_ct
 					rc = msm_dp_ctrl_link_lane_down_shift(ctrl, panel);
 					if (rc < 0) { /* lane == 1 already */
 						/* end with failure */
+						reason = "no lower rate or lane count left";
 						break;
 					}
 				} else {
 					/* end with failure */
-					break; /* lane == 1 already */
+					reason = "no clock recovery at the lowest rate";
+					break;
 				}
 			}
 		} else if (training_step == DP_TRAINING_2) {
 			/* link train_2 failed */
-			if (!msm_dp_aux_is_link_connected(ctrl->aux))
+			if (!msm_dp_aux_is_link_connected(ctrl->aux)) {
+				reason = "sink disconnected";
 				break;
-
-			drm_dp_dpcd_read_link_status(ctrl->aux, link_status);
+			}
 
 			if (!drm_dp_clock_recovery_ok(link_status,
 					ctrl->link->link_params.num_lanes))
@@ -2491,13 +2630,24 @@ int msm_dp_ctrl_on_link(struct msm_dp_ct
 
 			if (rc < 0) {
 				/* end with failure */
-				break; /* lane == 1 already */
+				reason = "no lower rate or lane count left";
+				break;
 			}
 
 			/* stop link training before start re training  */
 			msm_dp_ctrl_clear_training_pattern(ctrl, panel, DP_PHY_DPRX);
 		}
 
+		/* Like i915's intel_dp_can_link_train_fallback_for_edp() */
+		if (is_edp && !msm_dp_ctrl_link_fits_mode(ctrl, panel, pixel_rate)) {
+			reason = "no fallback can carry the mode";
+			rc = -EINVAL;
+			break;
+		}
+
+		msm_dp_ctrl_log_lt_attempt(ctrl, panel, &attempt,
+					   &ctrl->link->link_params);
+
 		rc = msm_dp_ctrl_reinitialize_mainlink(ctrl, panel);
 		if (rc) {
 			DRM_ERROR("Failed to reinitialize mainlink. rc=%d\n", rc);
@@ -2509,8 +2659,15 @@ int msm_dp_ctrl_on_link(struct msm_dp_ct
 	if (ctrl->link->sink_request & DP_TEST_LINK_PHY_TEST_PATTERN)
 		return rc;
 
-	if (!link_train_max_retries)
-		rc = -ETIMEDOUT;
+	if (rc) {
+		/* link_params describe the last attempt that ran */
+		ctrl->link->link_params = attempt.link_params;
+		ctrl->link->phy_params = attempt.phy_params;
+
+		msm_dp_ctrl_log_lt_attempt(ctrl, panel, &attempt, NULL);
+		msm_dp_ctrl_log_lt_give_up(ctrl, panel, "link training",
+					   &attempt, reason);
+	}
 
 	if (rc == 0) {  /* link train successfully */
 		/*
@@ -2535,9 +2692,40 @@ int msm_dp_ctrl_on_link(struct msm_dp_ct
 static int msm_dp_ctrl_link_retrain(struct msm_dp_ctrl_private *ctrl,
 				    struct msm_dp_panel *panel)
 {
-	int training_step = DP_TRAINING_NONE;
+	int retries = msm_dp_ctrl_is_edp(panel) ?
+		      MSM_DP_EDP_LT_SAME_PARAM_RETRIES : 0;
+	struct msm_dp_lt_attempt attempt = {};
+	int training_step;
+	int ret;
+
+	for (;;) {
+		training_step = DP_TRAINING_NONE;
+		ret = msm_dp_ctrl_setup_main_link(ctrl, panel, &training_step);
+		if (!ret)
+			return 0;
+
+		msm_dp_ctrl_record_lt_failure(ctrl, &attempt, training_step, ret);
+		if (attempt.num > retries) {
+			msm_dp_ctrl_log_lt_attempt(ctrl, panel, &attempt, NULL);
+			msm_dp_ctrl_log_lt_give_up(ctrl, panel,
+						   "link training before stream on",
+						   &attempt,
+						   retries ? "attempt limit reached" :
+							     "no retries for external DP");
+			return ret;
+		}
+		msm_dp_ctrl_log_lt_attempt(ctrl, panel, &attempt,
+					   &ctrl->link->link_params);
 
-	return msm_dp_ctrl_setup_main_link(ctrl, panel, &training_step);
+		/* eDP: same parameters again, after a PHY power cycle */
+		msm_dp_ctrl_clear_training_pattern(ctrl, panel, DP_PHY_DPRX);
+		msm_dp_link_reset_phy_params_vx_px(ctrl->link);
+		ret = msm_dp_ctrl_reinitialize_mainlink(ctrl, panel);
+		if (ret) {
+			DRM_ERROR("Failed to reinitialize mainlink. rc=%d\n", ret);
+			return ret;
+		}
+	}
 }
 
 static void msm_dp_ctrl_config_msa(struct msm_dp_ctrl_private *ctrl,
@@ -2636,8 +2824,12 @@ int msm_dp_ctrl_prepare_stream_on(struct
 		}
 	}
 
-	if (force_link_train || !msm_dp_ctrl_channel_eq_ok(ctrl))
-		msm_dp_ctrl_link_retrain(ctrl, panel);
+	if (force_link_train || !msm_dp_ctrl_channel_eq_ok(ctrl)) {
+		ret = msm_dp_ctrl_link_retrain(ctrl, panel);
+		/* External DP stays best effort; eDP would show nothing */
+		if (ret && !msm_dp_ctrl_is_edp(panel))
+			ret = 0;
+	}
 
 	/* stop txing train pattern to end link training */
 	msm_dp_ctrl_clear_training_pattern(ctrl, panel, DP_PHY_DPRX);
diff --git a/drivers/gpu/drm/msm/dp/dp_display.c b/drivers/gpu/drm/msm/dp/dp_display.c
--- a/drivers/gpu/drm/msm/dp/dp_display.c
+++ b/drivers/gpu/drm/msm/dp/dp_display.c
@@ -653,7 +653,7 @@ static int msm_dp_display_prepare_link(s
 
 	rc = msm_dp_ctrl_on_link(dp->ctrl, dp->panel);
 	if (rc) {
-		DRM_ERROR("Failed link training (rc=%d)\n", rc);
+		drm_dbg_dp(dp->drm_dev, "Failed link training (rc=%d)\n", rc);
 		// TODO: schedule drm_connector_set_link_status_property()
 		goto error;
 	}
@@ -1459,7 +1459,7 @@ void msm_dp_display_atomic_enable(struct
 
 	rc = msm_dp_display_prepare_link(dp);
 	if (rc) {
-		DRM_ERROR("DP display prepare failed, rc=%d\n", rc);
+		drm_dbg_dp(dp->drm_dev, "DP display prepare failed, rc=%d\n", rc);
 		return;
 	}
 
-- 
2.51.0
