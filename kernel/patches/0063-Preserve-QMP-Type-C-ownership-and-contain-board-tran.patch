 static void pmic_glink_altmode_worker(struct work_struct *work)
 {
 	struct pmic_glink_altmode_port *alt_port = work_to_altmode_port(work);
 	struct pmic_glink_altmode *altmode = alt_port->altmode;
-	enum drm_connector_status conn_status;
+	struct pmic_glink_altmode_state state;
+	enum drm_connector_status conn_status = connector_status_disconnected;
+	unsigned long flags, generation;
+	bool stale;
+	int ret;
 
-	typec_switch_set(alt_port->typec_switch, alt_port->orientation);
+	spin_lock_irqsave(&alt_port->state_lock, flags);
+	state = alt_port->pending;
+	generation = alt_port->generation;
+	spin_unlock_irqrestore(&alt_port->state_lock, flags);
 
-	/*
-	 * MUX_CTRL_STATE_DP4LN/USB3_DP may only be set if SVID=DP, but we need
-	 * to special-case the SVID=DP && mux_ctrl=NO_CONN case to deliver a
-	 * HPD notification
-	 */
-	if (alt_port->svid == USB_TYPEC_DP_SID) {
-		if (alt_port->mux_ctrl == MUX_CTRL_STATE_NO_CONN) {
-			pmic_glink_altmode_safe(altmode, alt_port);
-		} else {
-			pmic_glink_altmode_enable_dp(altmode, alt_port,
-						     alt_port->mode,
-						     alt_port->hpd_state,
-						     alt_port->hpd_irq);
-		}
+	ret = typec_switch_set(alt_port->typec_switch, state.orientation);
+	if (ret)
+		goto acknowledge;
 
-		if (alt_port->hpd_state)
-			conn_status = connector_status_connected;
+	if (state.svid == USB_TYPEC_DP_SID) {
+		if (state.mux_ctrl == MUX_CTRL_STATE_NO_CONN)
+			ret = pmic_glink_altmode_safe(altmode, alt_port);
 		else
-			conn_status = connector_status_disconnected;
-
-		drm_aux_hpd_bridge_notify(&alt_port->bridge->dev, conn_status);
-	} else if (alt_port->mux_ctrl == MUX_CTRL_STATE_TUNNELING) {
-		if (alt_port->svid == USB_TYPEC_TBT_SID)
-			pmic_glink_altmode_enable_tbt(altmode, alt_port);
+			ret = pmic_glink_altmode_enable_dp(altmode, alt_port,
+						 state.mode, state.hpd_state, state.hpd_irq);
+		if (!ret && (state.legacy || state.mux_ctrl != MUX_CTRL_STATE_NO_CONN) &&
+		    state.hpd_state)
+			conn_status = connector_status_connected;
+	} else if (state.mux_ctrl == MUX_CTRL_STATE_TUNNELING) {
+		if (state.svid == USB_TYPEC_TBT_SID)
+			ret = pmic_glink_altmode_enable_tbt(altmode, alt_port,
+						  &state.tbt_data, state.mode);
 		else
-			pmic_glink_altmode_enable_usb4(altmode, alt_port);
-	} else if (alt_port->mux_ctrl == MUX_CTRL_STATE_USB3_ONLY) {
-		pmic_glink_altmode_enable_usb(altmode, alt_port);
-	} else if (alt_port->mux_ctrl == MUX_CTRL_STATE_NO_CONN) {
-		pmic_glink_altmode_safe(altmode, alt_port);
+			ret = pmic_glink_altmode_enable_usb4(altmode, alt_port,
+						   &state.tbt_data);
+	} else if (state.mux_ctrl == MUX_CTRL_STATE_USB3_ONLY) {
+		ret = pmic_glink_altmode_enable_usb(altmode, alt_port);
 	} else {
-		dev_err(altmode->dev, "Got unknown mux_ctrl: %u on port %u, forcing safe mode\n",
-			alt_port->mux_ctrl, alt_port->index);
-		pmic_glink_altmode_safe(altmode, alt_port);
+		ret = pmic_glink_altmode_safe(altmode, alt_port);
 	}
 
+acknowledge:
+	/* A failed local configuration must still release the firmware event. */
 	pmic_glink_altmode_request(altmode, ALTMODE_PAN_ACK, alt_port->index);
+	spin_lock_irqsave(&alt_port->state_lock, flags);
+	stale = generation != alt_port->generation;
+	spin_unlock_irqrestore(&alt_port->state_lock, flags);
+	if (ret || stale)
+		conn_status = connector_status_disconnected;
+	if (ret)
+		dev_err(altmode->dev, "port %u configuration failed: %d\n", alt_port->index, ret);
+
+	/* Notifications schedule another work item; HPD may sleep. */
+	drm_aux_hpd_bridge_notify(&alt_port->bridge->dev, conn_status);
 }
 
