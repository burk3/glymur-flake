From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Burke Cates <burke.cates@gmail.com>
Date: Mon, 26 Oct 2026 09:49:53 -0700
Subject: [PATCH] NOT-FOR-UPSTREAM: rtc: qcom-glink: wake alarm via the SoCCP TAD timer

The SoCCP firmware on production Glymur laptops (ASUS Zenbook A16
UX3607OA, BIOS 312) serves the ACPI Time and Alarm Device wake timers
on pmic_glink owner 0x8010: 0x60 _GWS, 0x61 _CWS, 0x62 _STP, 0x63 _STV,
0x64 _TIP and 0x65 _TIV. A request is {hdr, timer, value}, timer 0 being
the AC and 1 the DC timer, and the reply is {hdr, value} with the value
(GWS, TIV) or a status (0 = success). _STV takes seconds from now on the
PMIC RTC counter and programs the PMIC RTC alarm. When the timer
expires while the OS runs, the firmware stops it, sets both _GWS bits
and sends a notification {0x8010, type 2, opcode 0x6a, timer}.

Use the AC timer for the RTC alarm: set_alarm() clears it with _CWS and
arms it for the seconds left, read_alarm() reads them back with _TIV
(0xffffffff when the timer is off) and the expired bit with _GWS, and
alarm_irq_enable() arms or clears it. _STV with 0 does not expire the
timer, the firmware turns on a retention mode instead, so a due alarm
is armed for one second.

The notification arrives through the glink interrupt, which stays
enabled in s2idle. Report it as a wakeup event, so that it ends s2idle,
and as RTC_AF once the timer status is cleared.

Assisted-by: Claude:claude-opus-5-5
---
Not-for-upstream: local workaround for one laptop, not reviewed for
  submission; use only for local testing.

 drivers/rtc/rtc-qcom-glink.c | 258 +++++++++++++++++++++++++++++++++--
 1 file changed, 248 insertions(+), 10 deletions(-)

diff --git a/drivers/rtc/rtc-qcom-glink.c b/drivers/rtc/rtc-qcom-glink.c
index 2be4a196e4a6..be87a22ac591 100644
--- a/drivers/rtc/rtc-qcom-glink.c
+++ b/drivers/rtc/rtc-qcom-glink.c
@@ -6,16 +6,19 @@
 #include <linux/build_bug.h>
 #include <linux/completion.h>
 #include <linux/device.h>
+#include <linux/devm-helpers.h>
 #include <linux/math.h>
 #include <linux/module.h>
 #include <linux/mutex.h>
 #include <linux/of.h>
 #include <linux/of_device.h>
+#include <linux/pm_wakeup.h>
 #include <linux/rtc.h>
 #include <linux/soc/qcom/pdr.h>
 #include <linux/soc/qcom/pmic_glink.h>
 #include <linux/spinlock.h>
 #include <linux/string.h>
+#include <linux/workqueue.h>
 
 #define RTC_GLINK_GIO_READ		0x90
 #define RTC_GLINK_GIO_WRITE		0x91
@@ -27,6 +30,20 @@
 #define RTC_GLINK_TZ_UNSPECIFIED	0x07ff
 #define RTC_GLINK_TZ_MAX		(24 * 60)
 
+/*
+ * ACPI Time and Alarm Device wake timers, served on the RTC owner. Requests
+ * carry the timer id and a value, replies carry a value or a status.
+ */
+#define RTC_GLINK_TAD_GWS		0x60
+#define RTC_GLINK_TAD_CWS		0x61
+#define RTC_GLINK_TAD_STV		0x63
+#define RTC_GLINK_TAD_TIV		0x65
+#define RTC_GLINK_TAD_EXPIRED		0x6a
+
+/* The AC timer; the firmware also has a DC timer (1) */
+#define RTC_GLINK_TAD_AC		0
+#define RTC_GLINK_TAD_DISABLED		U32_MAX
+
 /* How far the read back may be off from the time just written, in seconds */
 #define RTC_GLINK_SET_SLACK		2
 
@@ -69,9 +86,21 @@ struct qcom_rtc_glink_gio_write_resp {
 	__le32			status;
 };
 
+struct qcom_rtc_glink_tad_req {
+	struct pmic_glink_hdr	hdr;
+	__le32			timer;
+	__le32			value;
+};
+
+struct qcom_rtc_glink_tad_resp {
+	struct pmic_glink_hdr	hdr;
+	__le32			value;
+};
+
 struct qcom_rtc_glink {
 	struct device		*dev;
 	struct pmic_glink_client *client;
+	struct pmic_glink_client *tad_client;
 	struct rtc_device	*rtc;
 
 	/* Serializes requests: only one may be in flight at a time */
@@ -83,14 +112,21 @@ struct qcom_rtc_glink {
 	bool			service_up;
 	bool			request_pending;
 
+	u32			owner;
 	u32			opcode;
 	int			error;
 	struct qcom_rtc_glink_time resp_time;
+	u32			resp_value;
+
+	/* The alarm last set, to arm again on alarm_irq_enable() */
+	time64_t		alarm;
+	struct work_struct	alarm_work;
 
 	struct qcom_rtc_glink_gio_write_req write_req;
 };
 
 static int qcom_rtc_glink_request(struct qcom_rtc_glink *rtc_glink,
+				  struct pmic_glink_client *client,
 				  void *data, size_t len)
 {
 	struct pmic_glink_hdr *hdr = data;
@@ -111,12 +147,13 @@ static int qcom_rtc_glink_request(struct qcom_rtc_glink *rtc_glink,
 		spin_unlock_irqrestore(&rtc_glink->state_lock, flags);
 		return -ECONNRESET;
 	}
+	rtc_glink->owner = le32_to_cpu(hdr->owner);
 	rtc_glink->opcode = le32_to_cpu(hdr->opcode);
 	rtc_glink->error = -EIO;
 	rtc_glink->request_pending = true;
 	spin_unlock_irqrestore(&rtc_glink->state_lock, flags);
 
-	ret = pmic_glink_send(rtc_glink->client, data, len);
+	ret = pmic_glink_send(client, data, len);
 	if (ret < 0) {
 		spin_lock_irqsave(&rtc_glink->state_lock, flags);
 		rtc_glink->request_pending = false;
@@ -147,7 +184,8 @@ static int qcom_rtc_glink_get(struct qcom_rtc_glink *rtc_glink,
 	int ret;
 
 	mutex_lock(&rtc_glink->lock);
-	ret = qcom_rtc_glink_request(rtc_glink, &req, sizeof(req));
+	ret = qcom_rtc_glink_request(rtc_glink, rtc_glink->client, &req,
+				     sizeof(req));
 	if (!ret)
 		*t = rtc_glink->resp_time;
 	mutex_unlock(&rtc_glink->lock);
@@ -169,38 +207,96 @@ static int qcom_rtc_glink_put(struct qcom_rtc_glink *rtc_glink,
 	req->req.addr = cpu_to_le32(RTC_GLINK_TIME_ADDR);
 	req->req.len = cpu_to_le32(sizeof(*t));
 	memcpy(req->data, t, sizeof(*t));
-	ret = qcom_rtc_glink_request(rtc_glink, req, sizeof(*req));
+	ret = qcom_rtc_glink_request(rtc_glink, rtc_glink->client, req,
+				     sizeof(*req));
 	mutex_unlock(&rtc_glink->lock);
 
 	return ret;
 }
 
+/*
+ * Send a TAD request for the AC timer. GWS and TIV return a value, the
+ * others a status (0 on success).
+ */
+static int qcom_rtc_glink_tad(struct qcom_rtc_glink *rtc_glink, u32 opcode,
+			      u32 value, u32 *resp)
+{
+	struct qcom_rtc_glink_tad_req req = {
+		.hdr.owner = cpu_to_le32(PMIC_GLINK_OWNER_RTC),
+		.hdr.type = cpu_to_le32(PMIC_GLINK_REQ_RESP),
+		.hdr.opcode = cpu_to_le32(opcode),
+		.timer = cpu_to_le32(RTC_GLINK_TAD_AC),
+		.value = cpu_to_le32(value),
+	};
+	u32 v;
+	int ret;
+
+	mutex_lock(&rtc_glink->lock);
+	ret = qcom_rtc_glink_request(rtc_glink, rtc_glink->tad_client, &req,
+				     sizeof(req));
+	v = rtc_glink->resp_value;
+	mutex_unlock(&rtc_glink->lock);
+	if (ret)
+		return ret;
+
+	dev_dbg(rtc_glink->dev, "tad 0x%x(%u) -> 0x%x\n", opcode, value, v);
+
+	if (resp) {
+		*resp = v;
+		return 0;
+	}
+
+	return v ? -EIO : 0;
+}
+
 static void qcom_rtc_glink_callback(const void *data, size_t len, void *priv)
 {
 	struct qcom_rtc_glink *rtc_glink = priv;
 	const struct pmic_glink_hdr *hdr = data;
 	unsigned long flags;
-	u32 opcode;
+	u32 owner, opcode;
 	int err;
 
 	if (len < sizeof(*hdr))
 		return;
 
+	owner = le32_to_cpu(hdr->owner);
 	opcode = le32_to_cpu(hdr->opcode);
 
+	if (owner == PMIC_GLINK_OWNER_RTC &&
+	    le32_to_cpu(hdr->type) == PMIC_GLINK_NOTIFY) {
+		if (opcode == RTC_GLINK_TAD_EXPIRED) {
+			dev_dbg(rtc_glink->dev, "alarm expired %*ph\n",
+				(int)len, data);
+			pm_wakeup_dev_event(rtc_glink->dev, 0, true);
+			schedule_work(&rtc_glink->alarm_work);
+		}
+		return;
+	}
+
 	/*
 	 * Drop anything that is not the reply to the request in flight,
 	 * including replies to requests that already timed out.
 	 */
 	spin_lock_irqsave(&rtc_glink->state_lock, flags);
-	if (!rtc_glink->request_pending || opcode != rtc_glink->opcode) {
+	if (!rtc_glink->request_pending || owner != rtc_glink->owner ||
+	    opcode != rtc_glink->opcode) {
 		spin_unlock_irqrestore(&rtc_glink->state_lock, flags);
 		dev_dbg(rtc_glink->dev, "dropping message opcode=0x%x len=%zu\n",
 			opcode, len);
 		return;
 	}
 
-	if (opcode == RTC_GLINK_GIO_READ) {
+	if (owner == PMIC_GLINK_OWNER_RTC) {
+		const struct qcom_rtc_glink_tad_resp *resp = data;
+
+		if (len < sizeof(*resp)) {
+			err = -EBADMSG;
+		} else {
+			rtc_glink->resp_value = le32_to_cpu(resp->value);
+			err = 0;
+		}
+	} else if (opcode == RTC_GLINK_GIO_READ) {
 		const struct qcom_rtc_glink_gio_read_resp *resp = data;
 
 		if (len < sizeof(*resp)) {
@@ -360,13 +456,133 @@ static int qcom_rtc_glink_set_time(struct device *dev, struct rtc_time *tm)
 	return 0;
 }
 
+static int qcom_rtc_glink_now(struct device *dev, time64_t *now)
+{
+	struct qcom_rtc_glink *rtc_glink = dev_get_drvdata(dev);
+	struct qcom_rtc_glink_time t;
+	int ret;
+
+	ret = qcom_rtc_glink_get(rtc_glink, &t);
+	if (ret)
+		return ret;
+
+	return qcom_rtc_glink_to_time64(dev, &t, now);
+}
+
+/*
+ * The TAD timer counts seconds from when it is set, on the firmware's own
+ * RTC counter. Arm it for the time left until rtc_glink->alarm. A value of
+ * 0 does not expire the timer (the firmware turns on a "retention mode"
+ * instead), so an alarm that is due fires after a second.
+ */
+static int qcom_rtc_glink_arm(struct device *dev)
+{
+	struct qcom_rtc_glink *rtc_glink = dev_get_drvdata(dev);
+	time64_t now, left;
+	int ret;
+
+	ret = qcom_rtc_glink_now(dev, &now);
+	if (ret)
+		return ret;
+
+	left = clamp_t(time64_t, rtc_glink->alarm - now, 1,
+		       RTC_GLINK_TAD_DISABLED - 1);
+
+	return qcom_rtc_glink_tad(rtc_glink, RTC_GLINK_TAD_STV, left, NULL);
+}
+
+/* Stop the timer and clear its expired/wake status */
+static int qcom_rtc_glink_disarm(struct device *dev)
+{
+	struct qcom_rtc_glink *rtc_glink = dev_get_drvdata(dev);
+
+	return qcom_rtc_glink_tad(rtc_glink, RTC_GLINK_TAD_CWS, 0, NULL);
+}
+
+static int qcom_rtc_glink_read_alarm(struct device *dev,
+				     struct rtc_wkalrm *alrm)
+{
+	struct qcom_rtc_glink *rtc_glink = dev_get_drvdata(dev);
+	u32 left, status;
+	time64_t now;
+	int ret;
+
+	ret = qcom_rtc_glink_tad(rtc_glink, RTC_GLINK_TAD_TIV, 0, &left);
+	if (ret)
+		return ret;
+
+	ret = qcom_rtc_glink_tad(rtc_glink, RTC_GLINK_TAD_GWS, 0, &status);
+	if (ret)
+		return ret;
+
+	alrm->enabled = left != RTC_GLINK_TAD_DISABLED;
+	alrm->pending = status & BIT(0);
+	if (alrm->enabled) {
+		ret = qcom_rtc_glink_now(dev, &now);
+		if (ret)
+			return ret;
+		rtc_glink->alarm = now + left;
+	}
+	rtc_time64_to_tm(rtc_glink->alarm, &alrm->time);
+
+	return 0;
+}
+
+static int qcom_rtc_glink_set_alarm(struct device *dev,
+				    struct rtc_wkalrm *alrm)
+{
+	struct qcom_rtc_glink *rtc_glink = dev_get_drvdata(dev);
+	int ret;
+
+	ret = qcom_rtc_glink_disarm(dev);
+	if (ret)
+		return ret;
+
+	rtc_glink->alarm = rtc_tm_to_time64(&alrm->time);
+	if (!alrm->enabled)
+		return 0;
+
+	return qcom_rtc_glink_arm(dev);
+}
+
+static int qcom_rtc_glink_alarm_irq_enable(struct device *dev,
+					   unsigned int enabled)
+{
+	if (enabled)
+		return qcom_rtc_glink_arm(dev);
+
+	return qcom_rtc_glink_disarm(dev);
+}
+
+static void qcom_rtc_glink_alarm_work(struct work_struct *work)
+{
+	struct qcom_rtc_glink *rtc_glink =
+		container_of(work, struct qcom_rtc_glink, alarm_work);
+	int ret;
+
+	/* The firmware already stopped the timer; clear its status bits */
+	rtc_lock(rtc_glink->rtc);
+	ret = qcom_rtc_glink_disarm(rtc_glink->dev);
+	rtc_unlock(rtc_glink->rtc);
+	if (ret)
+		dev_dbg(rtc_glink->dev, "clearing the alarm failed: %d\n", ret);
+
+	rtc_update_irq(rtc_glink->rtc, 1, RTC_IRQF | RTC_AF);
+}
+
 static const struct rtc_class_ops qcom_rtc_glink_ro_ops = {
 	.read_time = qcom_rtc_glink_read_time,
+	.read_alarm = qcom_rtc_glink_read_alarm,
+	.set_alarm = qcom_rtc_glink_set_alarm,
+	.alarm_irq_enable = qcom_rtc_glink_alarm_irq_enable,
 };
 
 static const struct rtc_class_ops qcom_rtc_glink_rw_ops = {
 	.read_time = qcom_rtc_glink_read_time,
 	.set_time = qcom_rtc_glink_set_time,
+	.read_alarm = qcom_rtc_glink_read_alarm,
+	.set_alarm = qcom_rtc_glink_set_alarm,
+	.alarm_irq_enable = qcom_rtc_glink_alarm_irq_enable,
 };
 
 static const struct of_device_id qcom_rtc_glink_of_variants[] = {
@@ -379,6 +595,7 @@ static int qcom_rtc_glink_probe(struct auxiliary_device *adev,
 {
 	struct device *dev = &adev->dev;
 	struct qcom_rtc_glink *rtc_glink;
+	int ret;
 
 	if (!of_match_device(qcom_rtc_glink_of_variants, dev->parent))
 		return -ENXIO;
@@ -394,6 +611,17 @@ static int qcom_rtc_glink_probe(struct auxiliary_device *adev,
 	init_completion(&rtc_glink->ack);
 	dev_set_drvdata(dev, rtc_glink);
 
+	rtc_glink->rtc = devm_rtc_allocate_device(dev);
+	if (IS_ERR(rtc_glink->rtc))
+		return dev_err_probe(dev, PTR_ERR(rtc_glink->rtc),
+				     "failed to allocate RTC device\n");
+
+	/* Before the clients, so that it is cancelled after they are gone */
+	ret = devm_work_autocancel(dev, &rtc_glink->alarm_work,
+				   qcom_rtc_glink_alarm_work);
+	if (ret)
+		return ret;
+
 	rtc_glink->client = devm_pmic_glink_client_alloc(dev,
 							 PMIC_GLINK_OWNER_GIO,
 							 qcom_rtc_glink_callback,
@@ -403,12 +631,21 @@ static int qcom_rtc_glink_probe(struct auxiliary_device *adev,
 		return dev_err_probe(dev, PTR_ERR(rtc_glink->client),
 				     "failed to allocate glink client\n");
 
+	rtc_glink->tad_client = devm_pmic_glink_client_alloc(dev,
+							     PMIC_GLINK_OWNER_RTC,
+							     qcom_rtc_glink_callback,
+							     qcom_rtc_glink_pdr_notify,
+							     rtc_glink);
+	if (IS_ERR(rtc_glink->tad_client))
+		return dev_err_probe(dev, PTR_ERR(rtc_glink->tad_client),
+				     "failed to allocate glink client\n");
+
 	pmic_glink_client_register(rtc_glink->client);
+	pmic_glink_client_register(rtc_glink->tad_client);
 
-	rtc_glink->rtc = devm_rtc_allocate_device(dev);
-	if (IS_ERR(rtc_glink->rtc))
-		return dev_err_probe(dev, PTR_ERR(rtc_glink->rtc),
-				     "failed to allocate RTC device\n");
+	ret = devm_device_init_wakeup(dev);
+	if (ret)
+		return ret;
 
 	/*
 	 * As with rtc-pm8xxx, the time may only be set when the DT allows it.
@@ -421,6 +658,7 @@ static int qcom_rtc_glink_probe(struct auxiliary_device *adev,
 
 	rtc_glink->rtc->range_min = RTC_TIMESTAMP_BEGIN_2000;
 	rtc_glink->rtc->range_max = RTC_TIMESTAMP_END_2099;
+	clear_bit(RTC_FEATURE_UPDATE_INTERRUPT, rtc_glink->rtc->features);
 
 	return devm_rtc_register_device(rtc_glink->rtc);
 }
