From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Burke Cates <burke.cates@gmail.com>
Date: Sun, 25 Oct 2026 03:45:12 -0700
Subject: [PATCH] NOT-FOR-UPSTREAM: arm64: dts: qcom: glymur-asus-zenbook-a16: wire RGB and IR
 cameras

FixItFoundry zenbook-a16-linux camera-microphone-20261022 0007, unmodified
(the posting has no commit header). An adaptation of Konrad Dybcio's
linux-msm laptops-kernel commits 893830312dbb ("[WIP] ... Add PM8010"),
1bc6ad82803e ("Add RGB camera", OV02C10 on CCI1 bus 1 @0x36, CSIPHY4 x2
lanes, MCLK4, reset GPIO 239) and 8edb01d40899 ("Add IR camera", HM1092
on CCI0 bus 0 @0x24, CSIPHY0 x1 lane, MCLK0, reset GPIO 109), with
CAM_CC_TITAN_TOP_GDSC as each sensor's power domain and the PM8010's
input supplies, GPIO and interrupt controller properties left out.

NEEDS APPROVAL (CLAUDE.md "Never without explicit approval"): sets
regulator voltages (PM8010 L3 2.8 V, L4 1.8 V, L7 2.8 V) and clock rates
(assigned-clock-rates MCLK0 24 MHz, MCLK4 19.2 MHz), plus CSI-2
link-frequencies 180 MHz (HM1092) and 400 MHz (OV02C10).
Assisted-by: LLM
---
Not-for-upstream: local workaround for one laptop, not reviewed for
  submission; use only for local testing.

 .../qcom/glymur-asus-zenbook-a16-ux3607oa.dts | 177 +++++++++++++++++-
 1 file changed, 176 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/qcom/glymur-asus-zenbook-a16-ux3607oa.dts b/arch/arm64/boot/dts/qcom/glymur-asus-zenbook-a16-ux3607oa.dts
index 15037c63438a..6c34d6ff127f 100644
--- a/arch/arm64/boot/dts/qcom/glymur-asus-zenbook-a16-ux3607oa.dts
+++ b/arch/arm64/boot/dts/qcom/glymur-asus-zenbook-a16-ux3607oa.dts
@@ -16,6 +16,7 @@
 #include <dt-bindings/input/gpio-keys.h>
 #include <dt-bindings/input/input.h>
 #include <dt-bindings/leds/common.h>
+#include <dt-bindings/media/video-interfaces.h>
 #include <dt-bindings/pinctrl/qcom,pmic-gpio.h>
 
 /delete-node/ &pmh0104_l_e1;
@@ -136,7 +137,7 @@ keyboard-mic-led {
 			panic-indicator;
 		};
 
-		privacy-led {
+		privacy_led: privacy-led {
 			function = LED_FUNCTION_INDICATOR;
 			color = <LED_COLOR_ID_WHITE>;
 			gpios = <&tlmm 111 GPIO_ACTIVE_HIGH>;
@@ -644,6 +645,130 @@ vreg_l4f_e1: ldo4 {
 	};
 };
 
+&camss {
+	status = "okay";
+};
+
+&camss_csiphy0_inep {
+	data-lanes = <1>;
+};
+
+&camss_csiphy4_inep {
+	data-lanes = <1 2>;
+};
+
+&cci0 {
+	pinctrl-0 = <&cci0_0_default>;
+	pinctrl-1 = <&cci0_0_sleep>;
+
+	status = "okay";
+};
+
+&cci1 {
+	pinctrl-0 = <&cci1_1_default>;
+	pinctrl-1 = <&cci1_1_sleep>;
+
+	status = "okay";
+};
+
+&cci0_i2c0 {
+	camera@24 {
+		compatible = "himax,hm1092";
+		reg = <0x24>;
+
+		reset-gpios = <&tlmm 109 GPIO_ACTIVE_LOW>;
+
+		leds = <&privacy_led>;
+		led-names = "privacy";
+
+		power-domains = <&camcc CAM_CC_TITAN_TOP_GDSC>;
+
+		clocks = <&camcc CAM_CC_MCLK0_CLK>;
+		assigned-clocks = <&camcc CAM_CC_MCLK0_CLK>;
+		assigned-clock-rates = <24000000>;
+
+		orientation = <0>;
+
+		dvdd-supply = <&vreg_l4m>;
+		avdd-supply = <&vreg_l3m>;
+		dovdd-supply = <&vreg_l4m>;
+
+		pinctrl-0 = <&cam_mclk0_default>, <&cam_reset0_default>;
+		pinctrl-names = "default";
+
+		port {
+			hm1092_out_ep: endpoint {
+				data-lanes = <1>;
+				link-frequencies = /bits/ 64 <180000000>;
+				remote-endpoint = <&csiphy0_in_ep>;
+			};
+		};
+	};
+};
+
+&cci1_i2c1 {
+	camera@36 {
+		compatible = "ovti,ov02c10";
+		reg = <0x36>;
+
+		reset-gpios = <&tlmm 239 GPIO_ACTIVE_LOW>;
+
+		leds = <&privacy_led>;
+		led-names = "privacy";
+
+		power-domains = <&camcc CAM_CC_TITAN_TOP_GDSC>;
+
+		clocks = <&camcc CAM_CC_MCLK4_CLK>;
+		assigned-clocks = <&camcc CAM_CC_MCLK4_CLK>;
+		assigned-clock-rates = <19200000>;
+
+		orientation = <0>;
+
+		avdd-supply = <&vreg_l7m>;
+		dovdd-supply = <&vreg_l4m>;
+		dvdd-supply = <&vreg_l4m>;
+
+		pinctrl-0 = <&cam_mclk4_default>, <&cam_reset4_default>;
+		pinctrl-names = "default";
+
+		port {
+			ov02c10_out_ep: endpoint {
+				data-lanes = <1 2>;
+				link-frequencies = /bits/ 64 <400000000>;
+				remote-endpoint = <&csiphy4_in_ep>;
+			};
+		};
+	};
+};
+
+&csiphy0 {
+	vdda-0p9-supply = <&vreg_l1f_e1>;
+	vdda-1p2-supply = <&vreg_l4f_e1>;
+
+	status = "okay";
+};
+
+&csiphy0_in_ep {
+	bus-type = <MEDIA_BUS_TYPE_CSI2_DPHY>;
+	clock-lanes = <0>;
+	data-lanes = <1>;
+	remote-endpoint = <&hm1092_out_ep>;
+};
+
+&csiphy4 {
+	vdda-0p9-supply = <&vreg_l1f_e1>;
+	vdda-1p2-supply = <&vreg_l4f_e1>;
+
+	status = "okay";
+};
+
+&csiphy4_in_ep {
+	bus-type = <MEDIA_BUS_TYPE_CSI2_DPHY>;
+	clock-lanes = <0>;
+	data-lanes = <1 2>;
+	remote-endpoint = <&ov02c10_out_ep>;
+};
+
 &gpu {
 	/*
 	 * GLYMUR-A16: requires gpucc_glymur to NOT be blacklisted on the cmdline -
@@ -687,6 +812,40 @@ &i2c5 {
 
 	status = "okay";
 
+	pm8010: pmic@8 {
+		compatible = "qcom,pm8010-i2c";
+		reg = <0x8>;
+
+		reset-gpios = <&tlmm 106 GPIO_ACTIVE_LOW>;
+
+
+		/* shortcut: input rails remain firmware-managed until their supply mapping is verified. */
+
+		regulators {
+			/* L1/L2 are unused */
+
+			vreg_l3m: ldo3 {
+				regulator-name = "vreg_l3m";
+				regulator-min-microvolt = <2800000>;
+				regulator-max-microvolt = <2800000>;
+			};
+
+			vreg_l4m: ldo4 {
+				regulator-name = "vreg_l4m";
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+			};
+
+			/* L5/L6 are unused */
+
+			vreg_l7m: ldo7 {
+				regulator-name = "vreg_l7m";
+				regulator-min-microvolt = <2800000>;
+				regulator-max-microvolt = <2800000>;
+			};
+		};
+	};
+
 	ptn3222_1: redriver@43 {
 		compatible = "nxp,ptn3222";
 		reg = <0x43>;
@@ -1167,6 +1326,14 @@ keyboard_mic_led: keyboard-mic-led-state {
 		bias-disable;
 	};
 
+	cam_reset0_default: cam-reset0-default-state {
+		pins = "gpio109";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+
 	cam_indicator_en: cam-indicator-en-state {
 		pins = "gpio111";
 		function = "gpio";
@@ -1194,6 +1361,14 @@ keyboard_cam_led: keyboard-cam-led-state {
 		bias-disable;
 	};
 
+	cam_reset4_default: cam-reset4-default-state {
+		pins = "gpio239";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+
 	usb2_dp_hot_plug_detect: usb2-dp-hot-plug-detect-state {
 		pins = "gpio126";
 		function = "usb2_dp";
