diff --git a/drivers/soundwire/qcom.c b/drivers/soundwire/qcom.c
index 0e0ddfa99130..c6823c77fb0c 100644
--- a/drivers/soundwire/qcom.c
+++ b/drivers/soundwire/qcom.c
@@ -1470,37 +1470,70 @@ static int qcom_swrm_read_prop(struct sdw_bus *bus)
 	return 0;
 }
 
+/*
+ * Switch banks on a multi-master link. Each controller only changes its
+ * own register bank (MCP_STATUS) when the SCP_FrameCtrl broadcast goes
+ * out through its own command FIFO, and the primary's broadcast has not
+ * been seen to complete (SPECIAL_CMD_ID_FINISHED) without the dependent
+ * sending it too. Queue the broadcast on the dependent first (its FIFO
+ * empties straight away), then send it on the primary and wait for it as
+ * usual. A dependent that stays in the old bank would run its ports from
+ * the registers written for the next bank as soon as they are written,
+ * out of step with the peripherals' bank switch.
+ */
+static enum sdw_command_response
+qcom_swrm_mm_bank_switch(struct qcom_swrm_ctrl *ctrl, struct sdw_msg *msg)
+{
+	struct qcom_swrm_ctrl *peer = ctrl->peer_ctrl;
+	u8 cmd_id = SWR_BROADCAST_CMD_ID;
+	u32 val, sts, peer_sts, fifo;
+	int ret;
+
+	ctrl->reg_read(ctrl, SWRM_MCP_STATUS, &sts);
+	peer->reg_read(peer, SWRM_MCP_STATUS, &peer_sts);
+	if ((sts ^ peer_sts) & SWRM_MCP_STATUS_BANK_NUM_MASK)
+		dev_warn_ratelimited(ctrl->dev,
+				     "multi-master banks out of step: primary %d, dependent %d\n",
+				     !!(sts & SWRM_MCP_STATUS_BANK_NUM_MASK),
+				     !!(peer_sts & SWRM_MCP_STATUS_BANK_NUM_MASK));
+
+	val = swrm_get_packed_reg_val(&cmd_id, msg->buf[0],
+				      SDW_BROADCAST_DEV_NUM, msg->addr);
+	if (swrm_wait_for_wr_fifo_avail(peer))
+		return SDW_CMD_FAIL_OTHER;
+	peer->reg_write(peer, peer->reg_layout[SWRM_REG_CMD_FIFO_WR_CMD], val);
+
+	peer->reg_read(peer, peer->reg_layout[SWRM_REG_CMD_FIFO_STATUS], &fifo);
+	dev_dbg(ctrl->dev, "bank switch %#x: dependent FIFO %lu queued\n",
+		msg->addr, FIELD_GET(SWRM_WR_CMD_FIFO_CNT_MASK, fifo));
+
+	ret = qcom_swrm_cmd_fifo_wr_cmd(ctrl, msg->buf[0],
+					SDW_BROADCAST_DEV_NUM, msg->addr);
+	if (ret != SDW_CMD_OK)
+		dev_err_ratelimited(ctrl->dev,
+				    "multi-master bank switch %#x not finished: %d\n",
+				    msg->addr, ret);
+
+	if (!swrm_wait_for_wr_fifo_done(peer))
+		dev_err_ratelimited(ctrl->dev,
+				    "dependent did not send bank switch %#x\n",
+				    msg->addr);
+
+	return ret;
+}
+
