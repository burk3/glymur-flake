+1137  	{   {12,     0,    0},  {0x0,     0,    0,   0,     0xFF,  0xFF,  0xFF,   0xFF,    0xFF,      0xFF} }, //unsupported
+1138  	{   {13,     0,    0},  {0x0,     0,    0,   0,     0xFF,  0xFF,  0xFF,   0xFF,    0xFF,      0xFF} }, //unsupported
+1139  	{   {14,     0,    0},  {0x0,     0,    0,   0,     0xFF,  0xFF,  0xFF,   0xFF,    0xFF,      0xFF} }, //unsupported
