+1129  	{   {3,     3,     0}, {0x1,     3,    2,    0,     0xFF,  0xFF,  0xFF,   0xFF,    0xFF,      0} }, //Tx2
+1130  	{   {4,     4,     0}, {0x1,     3,    0,    0,     0xFF,  0xFF,  0xFF,   0xFF,    0xFF,      1} }, //Tx3
+1131  	{   {5,     0,     0}, {0x0,     0,    0, 0xFF,  0xFF,  0xFF,  0xFF,   0xFF,    0xFF,      0xFF} }, //SWR PCM not supported
+1132  	{   {6,      0,    0},  {0x0,     0,    0, 0xFF,  0xFF,  0xFF,  0xFF,   0xFF,    0xFF,      0xFF} }, //unsupported
