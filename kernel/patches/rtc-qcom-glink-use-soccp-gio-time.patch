-	}
-
-	ret = qcom_rtc_glink_get_property(rtc_glink, QCOM_RTC_GLINK_TIME,
-					  &ticks);
-	if (!ret && ticks != U32_MAX) {
-		rtc_time64_to_tm((time64_t)ticks + rtc_glink->offset, time);
-		return 0;
-	}
-
-	dev_err(rtc_glink->dev, "all time sources failed\n");
-	return -EIO;
-}
