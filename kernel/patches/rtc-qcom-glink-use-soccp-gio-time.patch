-	msg.real_time_data[0] = cpu_to_le32(w0);
-	msg.real_time_data[1] = cpu_to_le32(w1);
-	msg.real_time_data[2] = 0;
-	msg.real_time_data[3] = 0;
-	dev_dbg(rtc_glink->dev,
-		"TX opcode=0x%x data=%08x %08x\n",
