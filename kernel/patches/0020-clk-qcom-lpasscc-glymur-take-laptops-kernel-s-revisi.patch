 }
@@ -87,5 +85,5 @@ static struct platform_driver lpasscc_glymur_driver = {
 module_platform_driver(lpasscc_glymur_driver);
 
 MODULE_AUTHOR("Srinivas Kandagatla <srinivas.kandagatla@oss.qualcomm.com>");
